[Unit]
Description=Генератор ЕГЭ/ОГЭ — Daphne ASGI (HTTP + WebSocket уроков)
After=network.target postgresql.service
# С Redis-слоем каналов раскомментируйте: Wants=redis.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/itfluxacademy/itflux

RuntimeDirectory=itflux
LogsDirectory=itflux

# Секреты и production-env ТОЛЬКО через EnvironmentFile (не коммитить реальные значения).
# Скопируйте deploy/.env.production.example → /etc/itflux/itflux.env и заполните на сервере.
EnvironmentFile=-/etc/itflux/itflux.env

# WSGI (Gunicorn) не обрабатывает WebSocket: комната урока (/ws/lesson/…) не работает.
# Нужен ASGI — Daphne, иначе ученик не получает вариант и fetch к API не вызывается / падает по таймауту.
ExecStart=/opt/itfluxacademy/itflux/venv/bin/python3 -m daphne \
    -b 127.0.0.1 \
    -p 8002 \
    --access-log - \
    --proxy-headers \
    Generator.asgi:application

Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="DJANGO_SETTINGS_MODULE=Generator.settings"
Environment="DEBUG=false"
# Несекретные defaults (переопределяются EnvironmentFile при необходимости)
Environment="CHANNEL_LAYER_BACKEND=inmemory"
Environment="ITFLUX_PUBLIC_HOME_URL=https://tes.itflux.ru"

# Обязательные переменные задайте в /etc/itflux/itflux.env:
#   SECRET_KEY, DJANGO_ALLOWED_HOSTS, PGDATABASE, PGUSER, PGPASSWORD, PGHOST, PGPORT,
#   LESSON_SECRET, LK_PUBLIC_URL, LK_LESSON_NOTIFY_URL,
#   JITSI_*, VAPID_*, TELEGRAM_*, PAYMENT_* (не mock в production)

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
