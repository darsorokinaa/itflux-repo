# Скопируйте в /opt/.../Generator/.env (рядом с manage.py) или задайте в systemd EnvironmentFile=.
# Не коммить реальные секреты.

# —— Django ——
SECRET_KEY=
DEBUG=false
DJANGO_ALLOWED_HOSTS=generator.example.com,www.generator.example.com
# Доп. доверенные origin для CSRF (если не задано — https/http строятся из DJANGO_ALLOWED_HOSTS)
# CSRF_TRUSTED_ORIGINS=https://lk.example.com,https://generator.example.com
# Ограничить CORS (рекомендуется в проде). Через запятую, со схемой:
# CORS_ALLOWED_ORIGINS=https://generator.example.com,https://lk.example.com
# Редирект на HTTPS средствами Django (по умолчанию выкл.; обычно 301 в nginx)
# SECURE_SSL_REDIRECT=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# —— PostgreSQL ——
PGDATABASE=generatordb
PGUSER=generator_user
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432

# —— Уроки: JWT / ЛК (должны совпадать с 02_lk_generator) ——
LESSON_SECRET=
LESSON_WEBHOOK_SECRET=
LK_PUBLIC_URL=https://lk.example.com
# База API ЛК для server-to-server запросов (если пусто — используется LK_PUBLIC_URL)
CABINET_API_BASE=https://lk.example.com
# Важно: LESSON_SECRET и LESSON_WEBHOOK_SECRET должны совпадать со значениями в ЛК.
# Куда вести «Личный кабинет» после кнопки/разблокировки; если пусто — LK_PUBLIC_URL
# LK_DASHBOARD_URL=https://lk.example.com/dashboard
# Вебхуки (если пусто — LK_PUBLIC_URL + путь по умолчанию, см. settings.py)
# LK_LESSON_NOTIFY_URL=
# LK_LESSON_STUDENT_NOTIFY_URL=

# Пароль кнопки «Личный кабинет» на сайте генератора. Пустая строка LK_NAVIGATION_PASSWORD= — отключить.
# LK_NAVIGATION_PASSWORD=

# —— Публичные ссылки (редиректы после /admin/logout/ и т.д.) ——
GENUROK_PUBLIC_HOME_URL=https://genurok.ru

# —— Домашние задания: прокси генератор → ЛК (см. deploy/LK_GENUROK_DEBUG.md) ——
# LK_HOMEWORK_APPEND_TOKEN_QUERY=true
# LK_HOMEWORK_TOKEN_QUERY_PARAM=token
# LK_HOMEWORK_AUTHORIZATION_SCHEME=Bearer
# LK_HOMEWORK_FETCH_URL=

# —— WebSocket (Channels): Redis при нескольких воркерах ——
# CHANNEL_LAYER_BACKEND=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# Один процесс Daphne — можно:
# CHANNEL_LAYER_BACKEND=inmemory

# —— Прочее ——
# Секрет для ссылок на скачивание задач (если используется)
# LINK_SECRET_FOR_TASKS=
# Jitsi (опционально)
# JITSI_EMBED_EXTRA_HOSTS=meet.example.com
# JITSI_APP_ID=
# JITSI_APP_SECRET=
# Telegram — отчёты об ошибках
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=
