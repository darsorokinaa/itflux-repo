# Скопируйте в /opt/.../Generator/.env (рядом с manage.py) или задайте в systemd EnvironmentFile=.
# Не коммить реальные секреты.

# —— Django ——
SECRET_KEY=
DEBUG=false
DJANGO_ALLOWED_HOSTS=generator.example.com,www.generator.example.com
# Доп. доверенные origin для CSRF (если не задано — https/http строятся из DJANGO_ALLOWED_HOSTS)
# CSRF_TRUSTED_ORIGINS=https://lk.example.com,https://generator.example.com
# Ограничить CORS (рекомендуется в проде). Через запятую, со схемой:
# CORS_ALLOWED_ORIGINS=https://generator.example.com,https://lk.example.com
# Редирект на HTTPS средствами Django (по умолчанию выкл.; обычно 301 в nginx)
# SECURE_SSL_REDIRECT=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Ограничение: кто может публиковать планы в общий каталог «Готовые» (email через запятую)
LESSON_PLAN_CATALOG_PUBLISHER_EMAILS=dv_sorokina@mail.ru

PGDATABASE=itflux
PGUSER=itflux_user
PGPASSWORD=StrongPass123itflux20267
PGHOST=itflux-academy.ru
PGPORT=5432

# —— Уроки: JWT / ЛК (должны совпадать с 02_lk_generator) ——
LESSON_SECRET=
LESSON_WEBHOOK_SECRET=
LK_PUBLIC_URL=https://lk.example.com
# База API ЛК для server-to-server запросов (если пусто — используется LK_PUBLIC_URL)
CABINET_API_BASE=https://lk.example.com
# Важно: LESSON_SECRET и LESSON_WEBHOOK_SECRET должны совпадать со значениями в ЛК.
# Куда вести «Личный кабинет» после кнопки/разблокировки; если пусто — LK_PUBLIC_URL
# LK_DASHBOARD_URL=https://lk.example.com/dashboard
# Вебхуки (если пусто — LK_PUBLIC_URL + путь по умолчанию, см. settings.py)
# LK_LESSON_NOTIFY_URL=
# LK_LESSON_STUDENT_NOTIFY_URL=

# Пароль кнопки «Личный кабинет» на сайте генератора. Пустая строка LK_NAVIGATION_PASSWORD= — отключить.
# LK_NAVIGATION_PASSWORD=

# —— Публичные ссылки (редиректы после /admin/logout/ и т.д.) ——
ITFLUX_PUBLIC_HOME_URL=https://itflux-academy.ru

# —— Домашние задания: прокси генератор → ЛК (см. deploy/LK_ITFLUX_DEBUG.md) ——
# LK_HOMEWORK_APPEND_TOKEN_QUERY=true
# LK_HOMEWORK_TOKEN_QUERY_PARAM=token
# LK_HOMEWORK_AUTHORIZATION_SCHEME=Bearer
# LK_HOMEWORK_FETCH_URL=

# —— WebSocket (Channels): Redis при нескольких воркерах ——
# CHANNEL_LAYER_BACKEND=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# Один процесс Daphne — можно:
# CHANNEL_LAYER_BACKEND=inmemory

# —— Прочее ——
# Секрет для ссылок на скачивание задач (если используется)
# LINK_SECRET_FOR_TASKS=
# Jitsi (опционально)
# JITSI_EMBED_EXTRA_HOSTS=meet.example.com
# JITSI_APP_ID=
# JITSI_APP_SECRET=

# —— Яндекс Телемост (кнопка «Начать урок» в кабинете) ——
# ClientID приложения «Цифровой поток» (можно не задавать — есть default).
# YANDEX_TELEMOST_CLIENT_ID=21e10d82239446508ab6f2417c596fa2
# YANDEX_TELEMOST_CLIENT_SECRET=
# YANDEX_TELEMOST_REDIRECT_URI=https://oauth.yandex.ru/verification_code
# YANDEX_OAUTH_SCOPES=   # оставьте пустым — Яндекс выдаст права из настроек приложения
# YANDEX_CALENDAR_ENABLED=false  # true — Яндекс Календарь (CalDAV/embed); false — только расписание кабинета
# YANDEX_TELEMOST_OAUTH_TOKEN=
# YANDEX_TELEMOST_REFRESH_TOKEN=
# YANDEX_TELEMOST_AUTH_CODE=
# YANDEX_CALENDAR_LAYER_IDS=
# YANDEX_CALENDAR_TZ_ID=Europe/Moscow
# YANDEX_CALENDAR_EMBED_URL=
# YANDEX_ACCOUNT_EMAIL=darvitol.s@yandex.ru
# YANDEX_TELEMOST_COHOST_EMAIL=darvitol.s@yandex.ru
# YANDEX_TELEMOST_ALLOW_WEB_FALLBACK=true  # CalDAV X-TELEMOST-REQUIRED, если API недоступен
# YANDEX_TELEMOST_AUTO_CREATE=false  # не пытаться создавать ссылку при добавлении урока (личный @yandex.ru)

# Telegram — отчёты об ошибках (дайджест)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=

# Почта — мгновенное уведомление при «Сообщить об ошибке»
ERROR_REPORT_NOTIFY_EMAIL=itflux.academy@yandex.ru
# SMTP Яндекс: пароль приложения для ящика отправителя
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_HOST_USER=itflux.academy@yandex.ru
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=itflux.academy@yandex.ru
