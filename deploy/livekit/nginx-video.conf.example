# Пример. Подставьте свой домен и сертификат. Порт 7880 наружу не публиковать.
# Клиент LiveKit кладёт JWT в query string. В access_log пишем $uri, без query.
log_format video_safe '$remote_addr - $time_local "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 443 ssl;
    http2 on;
    server_name video.example.ru;

    ssl_certificate     /etc/letsencrypt/live/video.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/video.example.ru/privkey.pem;

    access_log /var/log/nginx/video.access.log video_safe;
    error_log /var/log/nginx/video.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
