# Скопируйте в /opt/jitsi/docker-jitsi-meet/.env после gen-passwords.sh
# и подставьте значения. Не коммитьте реальный JWT_APP_SECRET.

# --- базовое ---
CONFIG=~/.jitsi-meet-cfg
TZ=Europe/Moscow

PUBLIC_URL=https://lesson.itflux-academy.ru

# SSL на хосте (nginx) — контейнер только HTTP
ENABLE_LETSENCRYPT=0
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
HTTP_PORT=8000
HTTPS_PORT=8443

# Публичный IP сервера (WebRTC). Сейчас: 5.42.106.185
DOCKER_HOST_ADDRESS=5.42.106.185
JVB_ADVERTISE_IPS=5.42.106.185

# --- JWT (должен совпадать с Django) ---
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt

JWT_APP_ID=itflux
JWT_APP_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_ACCEPTED_ISSUERS=itflux
JWT_ACCEPTED_AUDIENCES=jitsi
