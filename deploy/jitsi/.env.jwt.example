# Django / gunicorn — значения должны совпадать с Prosody на lesson.itflux-academy.ru
# Синхронизация Prosody: bash deploy/jitsi/fix-jwt-prosody.sh

JITSI_DOMAIN=lesson.itflux-academy.ru
JITSI_AUTH_MODE=jwt
JITSI_APP_ID=generator_test
JITSI_APP_SECRET=same-as-prosody-app_secret
JITSI_SUB=lesson.itflux-academy.ru
JITSI_AUD=jitsi
JITSI_TOKEN_TTL_SECONDS=7200
JITSI_JOIN_BEFORE_MINUTES=15
JITSI_JOIN_AFTER_MINUTES=30
JITSI_EMBED_EXTRA_HOSTS=lesson.itflux-academy.ru
