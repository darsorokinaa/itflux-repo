# Django / gunicorn — после установки Jitsi на lesson.itflux-academy.ru

JITSI_DOMAIN=lesson.itflux-academy.ru
JITSI_AUTH_MODE=jwt
JITSI_APP_ID=itflux
JITSI_APP_SECRET=same-as-JWT_APP_SECRET-in-jitsi-env
JITSI_SUB=lesson.itflux-academy.ru
JITSI_AUD=jitsi
JITSI_TOKEN_TTL_SECONDS=7200
JITSI_JOIN_BEFORE_MINUTES=15
JITSI_JOIN_AFTER_MINUTES=30
JITSI_EMBED_EXTRA_HOSTS=lesson.itflux-academy.ru
