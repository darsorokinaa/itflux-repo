[Unit]
Description=ITFlux: VK funnel follow-ups (no-op while VK_FUNNEL_ENABLED=0)
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/itfluxacademy/itflux
EnvironmentFile=-/etc/itflux/itflux.env
EnvironmentFile=-/opt/itfluxacademy/itflux/.env
Environment="DJANGO_SETTINGS_MODULE=Generator.settings"
Environment="DEBUG=false"
ExecStart=/opt/itfluxacademy/itflux/venv/bin/python manage.py vk_funnel_followups
TimeoutStartSec=600
Nice=10
