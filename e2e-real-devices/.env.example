# Cabinet login (never commit real values)
TEST_LOGIN=
TEST_PASSWORD=

# Full URL of a live lesson room, e.g. https://example.com/cabinet/meetings/<uuid>
LESSON_ROOM_URL=

# Optional origin override. Default: origin of LESSON_ROOM_URL
# TEST_BASE_URL=https://example.com

# Long-session duration in minutes (TEST 5). Default: 60
# TEST_MINUTES=60

# BrowserStack Automate (also accepted by the SDK)
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=

# Device matrix (selenium-ios/matrix.js). Defaults shown.
# DEVICE_OS=all
# DEVICE_KIND=all
# MAX_DEVICES=0
# DEVICE_CONCURRENCY=1
# BOARD_TEST_MODE=smoke
# TEST_MINUTES=60
# DEVICE_NAME=iPhone 17
# DEVICE_OS_VERSION=26
