# Публичный URL личного кабинета: тот же origin, что и сессия ЛК (CORS + credentials).
# Нужен для ссылок в UI и API ДЗ (GET/POST …/api/homework/…).
# Скопируйте в .env или задайте при сборке: VITE_LK_PUBLIC_URL=… npm run build
#
# —— Продакшен (перед npm run build) ——
#   VITE_LK_PUBLIC_URL=https://lk.ваш-домен.ru
# Должен совпадать с LK_PUBLIC_URL на бэкенде (origin без лишнего слэша).
# Для варианта в уроке с lesson_token фронт ходит на прокси того же host, что и вариант — VITE_ может не требоваться;
#   без токена — нужен тот же origin, что и у ЛК.
#
#   # локально / стейдж:
#   # VITE_LK_PUBLIC_URL=http://127.0.0.1:8001
#
# Устаревшее имя: VITE_LK_URL
VITE_LK_PUBLIC_URL=http://127.0.0.1:8001

