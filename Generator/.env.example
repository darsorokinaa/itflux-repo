# Скопируйте в Generator/.env и заполните значения:
#   cp Generator/.env.example Generator/.env
#
# frontend/.env — только для Vite (VITE_*), сюда платежи не пишите.

# —— Платежи Т-Банк ——
# Документация: https://developer.tbank.ru/eacq/scenarios/payments/nonPCI/
# true — оплата тарифов включена; false — create-payment возвращает 503
PAYMENTS_ENABLED=true
PAYMENT_PROVIDER=tbank
TBANK_TERMINAL_KEY=
# Если в пароле есть # — обязательно в кавычках:
TBANK_PASSWORD="your-password-with-#chars"

# Публичный URL сайта (на проде — ваш домен; локально можно оставить 127.0.0.1)
LK_PUBLIC_URL=http://127.0.0.1:8001

# Локальная проверка оплаты (DEBUG):
# Vite в репо слушает порт 5001 (frontend/vite.config.js).
# TBANK_SUCCESS_URL=http://127.0.0.1:5001/cabinet/upgrade
# TBANK_FAIL_URL=http://127.0.0.1:5001/cabinet/upgrade
# Банк часто всё равно уводит на SuccessURL из ЛК терминала (прод) —
# локально фронт открывает форму в новой вкладке и ждёт GetState.
# Webhook: ngrok http 8000 →
# TBANK_NOTIFICATION_URL=https://xxxx.ngrok-free.app/payments/webhook/tbank/

# Опционально:
# TBANK_API_URL=https://securepay.tinkoff.ru/v2
# Если Init падает с SSLCertVerificationError (антивирус) — локально:
# TBANK_VERIFY_SSL=false
# Чек (Receipt) в Init — для сценария «Формирование чека»:
# TBANK_TAXATION=usn_income
# TBANK_VAT=none
# TBANK_FFD_VERSION=1.05
# TBANK_RECEIPT_EMAIL=fallback@example.com
